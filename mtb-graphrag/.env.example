# Neo4j locale
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Endpoint LLM
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=
LLM_PIPELINE=gemma4:31b-cloud
LLM_JUDGE=minimax-m2.5

# Ledger append-only della raccolta agentica (montare la directory su volume in produzione)
AGENT_LEDGER_PATH=./data/agent_events.sqlite3
NCBI_EMAIL=
SOURCE_VERIFIER_BATCH_SIZE=4

# Integrazione opzionale
ONCOKB_TOKEN=

# Frontend, se servito da una origine diversa
CORS_ORIGINS=http://localhost:5173

# --- Planner agentico (budget e resilienza) ---
PLANNER_TIMEOUT_SECONDS=20
PLANNER_MAX_RETRIES=1
PLANNER_TOTAL_BUDGET_SECONDS=30

# --- Source verifier ---
SOURCE_VERIFIER_MAX_WORKERS=1
SOURCE_VERIFIER_RETRY_TIMEOUT_SECONDS=15
SOURCE_VERIFIER_RETRY_MAX_WORKERS=1
# Revisione del modello usata come componente della chiave di cache del profilo
# sorgente. Se assente viene derivata da LLM_PIPELINE (ollama:<modello>).
# La temperatura non ne fa parte: non e' una revisione del modello.
# SOURCE_VERIFIER_MODEL_REVISION=ollama:gemma4:31b-cloud

# --- Cache del profilo sorgente ---
# Per isolare le fasi cold/warm negli esperimenti, usare un file per run.
SOURCE_PROFILE_CACHE_PATH=./data/source_profile_cache.sqlite3
