{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qualified_retrieval_query.schema.json",
  "title": "QualifiedRetrievalQuery",
  "type": "object",
  "required": ["query_id", "disease", "biomarkers", "mode", "top_k"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string"},
    "disease": {"type": "string", "minLength": 1},
    "disease_aliases": {"type": "array", "items": {"type": "string"}},
    "biomarkers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "gene": {"type": "string"},
          "alteration": {"type": "string"},
          "normalized": {"type": "string"}
        }
      }
    },
    "interventions": {"type": "array", "items": {"type": "string"}},
    "directions": {"type": "array", "items": {"type": "string"}},
    "assertion_polarities": {"type": "array", "items": {"type": "string"}},
    "evidence_scopes": {"type": "array", "items": {"type": "string"}},
    "preferred_evidence_context": {"enum": ["clinical", "preclinical", "both"]},
    "clinical_context": {"type": "object"},
    "top_k": {"type": "integer", "minimum": 1, "maximum": 500},
    "mode": {"enum": ["v2_compatibility", "native_only", "qualified_soft", "audit_all"]},
    "corpus_fingerprint": {"type": "string"}
  },
  "additionalProperties": false
}
