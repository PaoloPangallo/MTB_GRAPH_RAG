    "table_label": null,
    "text": "RCSD1-ABL1-positive B lymphoblastic leukemia is sensitive to dexamethasone and tyrosine kinase inhibitors and rapidly evolves clonally by chromosomal translocations.",
    "unit_type": "TITLE"
  },
  {
    "bbox": null,
    "caption": null,
    "char_end": 1173,
    "char_start": 0,
