    "text": "A survey of DICER1 hotspot mutations in ovarian and testicular sex cord-stromal tumors.",
    "unit_type": "TITLE"
  },
  {
    "bbox": null,
    "caption": null,
    "char_end": 2163,
    "char_start": 0,
    "column": null,
    "content_hash": "237350ef6b8b979e2da6254b913b76adf79bb743270eaa33c9a18e73a28acef5",
    "document_id": "pmid:26428316",
    "figure_id": null,
