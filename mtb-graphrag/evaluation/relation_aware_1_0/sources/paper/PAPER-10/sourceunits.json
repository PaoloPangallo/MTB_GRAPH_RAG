    "text": "Rociletinib in EGFR-mutated non-small-cell lung cancer.",
    "unit_type": "TITLE"
  },
  {
    "bbox": null,
    "caption": null,
    "char_end": 2013,
    "char_start": 0,
    "column": null,
    "content_hash": "aabe28f21d1429781f2357365444c790212894eaecbb97824e8723e8d0690827",
    "document_id": "pmid:25923550",
    "figure_id": null,
    "figure_label": null,
    "locator_confidence": "STRUCTURAL",
