    "row": null,
    "section": null,
    "sentence_index": 26,
    "source_unit_id": "SU-7c7048f36a92b8c9e8f950df",
    "subsection": null,
    "table_id": null,
    "table_label": null,
    "text": "These results extend the potential usefulness of PARP inhibitors in the treatment setting beyond BRCA mutant tumours.",
    "unit_type": "ABSTRACT_SENTENCE"
  },
