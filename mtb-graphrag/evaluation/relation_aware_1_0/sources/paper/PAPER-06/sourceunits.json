    "row": null,
    "section": null,
    "sentence_index": 23,
    "source_unit_id": "SU-65b32c6277ceb721f03dcf06",
    "subsection": null,
    "table_id": null,
    "table_label": null,
    "text": "No treatment-related deaths occurred.",
    "unit_type": "ABSTRACT_SENTENCE"
  },
  {
    "bbox": null,
    "caption": null,
    "char_end": 3540,
    "char_start": 3325,
    "column": null,
    "content_hash": "1795521eb5caf5b4ee1c74c25dc46b23e5a386f508407357fd2ade53b049af85",
    "document_id": "pmid:27908594",
    "figure_id": null,
    "figure_label": null,
    "locator_confidence": "STRUCTURAL",
    "page": null,
    "paragraph_index": null,
    "parser": "PubMedAbstractParser",
