    "row": null,
    "section": null,
    "sentence_index": 24,
    "source_unit_id": "SU-1795521eb5caf5b4ee1c74c2",
    "subsection": null,
    "table_id": null,
    "table_label": null,
    "text": "In patients with BRCA mutant or BRCA wild-type and LOH high platinum-sensitive ovarian carcinomas treated with rucaparib, progression-free survival was longer than in patients with BRCA wild-type LOH low carcinomas.",
    "unit_type": "ABSTRACT_SENTENCE"
  },
  {
    "bbox": null,
    "caption": null,
    "char_end": 3712,
    "char_start": 3541,
    "column": null,
    "content_hash": "b437b920ddde1c64dcc58a15b667cf19ca91805caa3fd5bd384e82c23846dec6",
    "document_id": "pmid:27908594",
    "figure_id": null,
    "figure_label": null,
    "locator_confidence": "STRUCTURAL",
    "page": null,
    "paragraph_index": null,
    "parser": "PubMedAbstractParser",
    "parser_version": "1.0",
    "row": null,
    "section": null,
    "sentence_index": 25,
    "source_unit_id": "SU-b437b920ddde1c64dcc58a15",
    "subsection": null,
    "table_id": null,
    "table_label": null,
    "text": "Our results suggest that assessment of tumour LOH can be used to identify patients with BRCA wild-type platinum-sensitive ovarian cancers who might benefit from rucaparib.",
    "unit_type": "ABSTRACT_SENTENCE"
  },
  {
    "bbox": null,
    "caption": null,
    "char_end": 3830,
    "char_start": 3713,
    "column": null,
    "content_hash": "7c7048f36a92b8c9e8f950dfa79253c390e11d2581e8bea8b979742a04580f95",
    "document_id": "pmid:27908594",
    "figure_id": null,
    "figure_label": null,
    "locator_confidence": "STRUCTURAL",
    "page": null,
    "paragraph_index": null,
    "parser": "PubMedAbstractParser",
