digraph phase {
graph [rankdir="TB", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", splines=polyline, label="Costruire il dossier", labelloc=t, fontname="Arial", fontsize=21, fontcolor="#17343F"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16, fontcolor="#17343F", color="#B7C9CF", penwidth=1, margin="0.18,0.14"];
edge [color="#718895", fontname="Arial", fontcolor="#365661", fontsize=12, arrowsize=0.65];
"paper" [id="node-paper", shape="box", label="Pubblicazioni\nOsservazioni, citazioni e controlli", fillcolor="#EAF0F5", tooltip="Pubblicazioni\nOsservazioni, citazioni e controlli"];
"registri" [id="node-registri", shape="box", label="Registri di studio\nInformazioni e limiti di eleggibilità", fillcolor="#EAF0F5", tooltip="Registri di studio\nInformazioni e limiti di eleggibilità"];
"grafo" [id="node-grafo", shape="box", label="Solo Knowledge Graph\nRelazioni e provenienza", fillcolor="#EAF0F5", tooltip="Solo Knowledge Graph\nRelazioni e provenienza"];
"aggregare" [id="node-aggregare", shape="box", label="Aggregare osservazioni per relazione\nConservare supporto, conflitti e incertezze", fillcolor="#E8F4F0", tooltip="Aggregare osservazioni per relazione\nConservare supporto, conflitti e incertezze"];
"sezioni" [id="node-sezioni", shape="box", label="Costruire le sezioni del dossier\nRelazione + fonte + osservazione\nControlli + limiti", fillcolor="#E8F4F0", tooltip="Costruire le sezioni del dossier\nRelazione + fonte + osservazione\nControlli + limiti"];
"accounting" [id="node-accounting", shape="box", label="Confrontare risultati e lavoro svolto\nRendere visibili omissioni e attività non\neseguite", fillcolor="#F0EBF6", tooltip="Confrontare risultati e lavoro svolto\nRendere visibili omissioni e attività non eseguite"];
"dossier" [id="node-dossier", shape="box", label="Dossier di riferimento\nGià disponibile prima della spiegazione", fillcolor="#E6F3EC", tooltip="Dossier di riferimento\nGià disponibile prima della spiegazione"];
"paper" -> "aggregare" [label="tutte le osservazioni", style="solid"];
"aggregare" -> "sezioni" [label="esito documentale della\nrelazione", style="solid"];
"registri" -> "sezioni" [label="contesto di studio", style="solid"];
"grafo" -> "sezioni" [label="origine nel grafo", style="solid"];
"sezioni" -> "accounting" [label="voci del dossier", style="solid"];
"accounting" -> "dossier" [label="contenuto riconciliato", style="solid"];
{rank=same; "paper"; "registri"; "grafo";}
}