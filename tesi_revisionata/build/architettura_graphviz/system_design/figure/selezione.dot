digraph phase {
graph [rankdir="TB", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", splines=polyline, label="Scegliere che cosa leggere", labelloc=t, fontname="Arial", fontsize=21, fontcolor="#17343F"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16, fontcolor="#17343F", color="#B7C9CF", penwidth=1, margin="0.18,0.14"];
edge [color="#718895", fontname="Arial", fontcolor="#365661", fontsize=12, arrowsize=0.65];
"domanda" [id="node-domanda", shape="box", label="Relazione cercata + unità del documento", fillcolor="#EAF0F5", tooltip="Relazione cercata + unità del documento"];
"filtri" [id="node-filtri", shape="box", label="Escludere unità non ammissibili\nPrima della fusione", fillcolor="#F0EBF6", tooltip="Escludere unità non ammissibili\nPrima della fusione"];
"bm25" [id="node-bm25", shape="box", label="BM25 strutturale\nParole × prior e fattore di sezione", fillcolor="#E8F4F0", tooltip="BM25 strutturale\nParole × prior e fattore di sezione"];
"dense" [id="node-dense", shape="box", label="MedCPT\nPertinenza semantica", fillcolor="#FBF1DD", tooltip="MedCPT\nPertinenza semantica"];
"rrf" [id="node-rrf", shape="box", label="Reciprocal Rank Fusion\nSomma di 1 / (60 + rango)", fillcolor="#E8F4F0", tooltip="Reciprocal Rank Fusion\nSomma di 1 / (60 + rango)"];
"top" [id="node-top", shape="box", label="Selezionare fino a top-k passaggi\nApplicare vincoli di sovrapposizione", fillcolor="#E8F4F0", tooltip="Selezionare fino a top-k passaggi\nApplicare vincoli di sovrapposizione"];
"reader" [id="node-reader", shape="box", label="Unità autorizzate per il Reader", fillcolor="#E6F3EC", tooltip="Unità autorizzate per il Reader"];
"domanda" -> "filtri" [label="unità e relazione", style="solid"];
"filtri" -> "bm25" [label="unità ammissibili", style="solid"];
"filtri" -> "dense" [label="unità ammissibili", style="solid"];
"bm25" -> "rrf" [label="posizioni nella classifica", style="solid"];
"dense" -> "rrf" [label="posizioni nella classifica", style="solid"];
"rrf" -> "top" [label="ordine fuso", style="solid"];
"bm25" -> "top" [label="ripiego se MedCPT non\ndisponibile", style="dashed"];
"top" -> "reader" [label="passaggi selezionati", style="solid"];
{rank=same; "bm25"; "dense";}
}