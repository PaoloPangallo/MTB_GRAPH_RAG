digraph phase {
graph [rankdir="TB", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", splines=polyline, label="Controllare il legame con il testo", labelloc=t, fontname="Arial", fontsize=21, fontcolor="#17343F"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16, fontcolor="#17343F", color="#B7C9CF", penwidth=1, margin="0.18,0.14"];
edge [color="#718895", fontname="Arial", fontcolor="#365661", fontsize=12, arrowsize=0.65];
"campo" [id="node-campo", shape="box", label="Valore del parser + citazione\nEsempio: variante V600K, citazione «V600K»", fillcolor="#EAF0F5", tooltip="Valore del parser + citazione\nEsempio: variante V600K, citazione «V600K»"];
"originale" [id="node-originale", shape="box", label="Testo clinico originale", fillcolor="#EAF0F5", tooltip="Testo clinico originale"];
"ricerca" [id="node-ricerca", shape="box", label="Cercare la citazione letterale\nContare le occorrenze nel testo", fillcolor="#E8F4F0", tooltip="Cercare la citazione letterale\nContare le occorrenze nel testo"];
"posizione" [id="node-posizione", shape="box", label="Ricostruire o disambiguare la posizione\nGli offset aiutano solo se coerenti", fillcolor="#E8F4F0", tooltip="Ricostruire o disambiguare la posizione\nGli offset aiutano solo se coerenti"];
"valore" [id="node-valore", shape="box", label="Confrontare valore e citazione\nControllare separatamente gene e variante", fillcolor="#F0EBF6", tooltip="Confrontare valore e citazione\nControllare separatamente gene e variante"];
"esiti" [id="node-esiti", shape="box", label="Campo ancorato · non corrispondente ·\nincerto\nCampo non valorizzato → assente", fillcolor="#E6F3EC", tooltip="Campo ancorato · non corrispondente · incerto\nCampo non valorizzato → assente"];
"campo" -> "ricerca" [label="citazione proposta", style="solid"];
"originale" -> "ricerca" [label="testo autorevole", style="solid"];
"ricerca" -> "posizione" [label="occorrenze", style="solid"];
"posizione" -> "valore" [label="citazione localizzata", style="solid"];
"valore" -> "esiti" [label="esito per campo", style="solid"];
{rank=same; "campo"; "originale";}
}