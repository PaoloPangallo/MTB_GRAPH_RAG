digraph macro {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.30", ranksep="0.40", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17, fontcolor="#17343F", color="#AFC4C8", penwidth=1, margin="0.20,0.15"];
edge [color="#617E87", fontname="Arial", fontcolor="#365661", fontsize=13, arrowsize=0.7];
graph [label="Costruire il dossier · Solo Knowledge Graph", labelloc=t, fontname="Arial", fontsize=22, fontcolor="#17343F", labeljust=c];
"relazione" [id="node-relazione", label="FoundationOne CDx → gene BRAF", shape="box", fillcolor="#EAF0F5", tooltip="FoundationOne CDx → gene BRAF"];
"fonte" [id="node-fonte", label="FoundationOne CDx → BRAF", shape="box", fillcolor="#EAF0F5", tooltip="FoundationOne CDx → BRAF"];
"raccolta" [id="node-raccolta", label="Comporre la voce del dossier\nConservare la natura della fonte", shape="box", fillcolor="#E8F4F0", tooltip="Comporre la voce del dossier\nConservare la natura della fonte"];
"voce" [id="node-voce", label="Relazione: FoundationOne CDx → gene BRAF\nFonte: FoundationOne CDx → BRAF\nNessuna osservazione documentale\nNessun documento associato\nSola provenienza nel Knowledge Graph\nNessuna verifica documentale attribuita\nLimite: Livello del gene, non della variante\nIl test non è dichiarato nel caso", shape="box", fillcolor="#E6F3EC", tooltip="Relazione: FoundationOne CDx → gene BRAF\nFonte: FoundationOne CDx → BRAF\nNessuna osservazione documentale\nNessun documento associato\nSola provenienza nel Knowledge Graph\nNessuna verifica documentale attribuita\nLimite: Livello del gene, non della variante\nIl test non è dichiarato nel caso"];
"relazione" -> "raccolta" [label="relazione cercata", style="solid"];
"fonte" -> "raccolta" [label="origine", style="solid"];
"raccolta" -> "voce" [label="osservazione + controlli + limiti", style="solid"];
}