digraph macro {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.30", ranksep="0.40", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17, fontcolor="#17343F", color="#AFC4C8", penwidth=1, margin="0.20,0.15"];
edge [color="#617E87", fontname="Arial", fontcolor="#365661", fontsize=13, arrowsize=0.7];
graph [label="Rendere leggibili gli esiti · Registro di studio clinico", labelloc=t, fontname="Arial", fontsize=22, fontcolor="#17343F", labeljust=c];
"record" [id="node-record", label="Registro NCT02279004", shape="box", fillcolor="#EAF0F5", tooltip="Registro NCT02279004"];
"operativo" [id="node-operativo", label="Esito operativo documentato: ambiguo\nNon è lo stato di reclutamento dello studio", shape="box", fillcolor="#E8F4F0", tooltip="Esito operativo documentato: ambiguo\nNon è lo stato di reclutamento dello studio"];
"dossier" [id="node-dossier", label="Voce del registro nel dossier\nEleggibilità individuale non valutata", shape="box", fillcolor="#E6F3EC", tooltip="Voce del registro nel dossier\nEleggibilità individuale non valutata"];
"record" -> "operativo" [label="esito del gate", style="solid"];
"operativo" -> "dossier" [label="contesto e limiti separati", style="solid"];
}