digraph macro {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.30", ranksep="0.40", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17, fontcolor="#17343F", color="#AFC4C8", penwidth=1, margin="0.20,0.15"];
edge [color="#617E87", fontname="Arial", fontcolor="#365661", fontsize=13, arrowsize=0.7];
graph [label="Dossier · Pubblicazione", labelloc=t, fontname="Arial", fontsize=22, fontcolor="#17343F", labeljust=c];
"relazione" [id="macro-node-relazione", label="BRAF V600K → descrizione dello studio", shape="box", fillcolor="#EAF0F5", tooltip="BRAF V600K → descrizione dello studio"];
"fonte" [id="macro-node-fonte", label="Pubblicazione 28891408", shape="box", fillcolor="#EAF0F5", tooltip="Pubblicazione 28891408"];
"raccolta" [id="macro-node-raccolta", label="Comporre la voce del dossier\nConservare la natura della fonte", shape="box", fillcolor="#E8F4F0", tooltip="Comporre la voce del dossier\nConservare la natura della fonte"];
"voce" [id="macro-node-voce", label="Relazione: BRAF V600K → descrizione dello studio\nFonte: Pubblicazione 28891408\nAdiuvante, melanoma di stadio III\nV600E oppure V600K\nCitazione autentica\nSupporto non attribuito alla relazione\nLimite: Nessun trasferimento automatico\nal caso metastatico o alla sola V600K", shape="box", fillcolor="#E6F3EC", tooltip="Relazione: BRAF V600K → descrizione dello studio\nFonte: Pubblicazione 28891408\nAdiuvante, melanoma di stadio III\nV600E oppure V600K\nCitazione autentica\nSupporto non attribuito alla relazione\nLimite: Nessun trasferimento automatico\nal caso metastatico o alla sola V600K"];
"relazione" -> "raccolta" [label="relazione cercata", style="solid"];
"fonte" -> "raccolta" [label="origine", style="solid"];
"raccolta" -> "voce" [label="osservazione + controlli + limiti", style="solid"];
}