digraph macro {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.30", ranksep="0.40", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17, fontcolor="#17343F", color="#AFC4C8", penwidth=1, margin="0.20,0.15"];
edge [color="#617E87", fontname="Arial", fontcolor="#365661", fontsize=13, arrowsize=0.7];
graph [label="Controllare la spiegazione finale · Registro di studio clinico", labelloc=t, fontname="Arial", fontsize=22, fontcolor="#17343F", labeljust=c];
"dossier" [id="node-dossier", label="Registro NCT02279004\nInformazioni dello studio\nEleggibilità individuale non valutata", shape="box", fillcolor="#EAF0F5", tooltip="Dossier di riferimento"];
"ricostruire" [id="node-ricostruire", label="Ricostruire catalogo e testo atteso\nIndipendentemente dalla proposta", shape="box", fillcolor="#E8F4F0", tooltip="Ricostruire catalogo e testo atteso\nIndipendentemente dalla proposta"];
"proposta" [id="node-proposta", label="Testo e piano proposti\nDal modello o dall’alternativa", shape="box", fillcolor="#EAF0F5", tooltip="Testo e piano proposti\nDal modello o dall’alternativa"];
"piano" [id="node-piano", label="Verificare piano, identità e copertura", shape="box", fillcolor="#F0EBF6", tooltip="Verificare piano, identità e copertura"];
"confronto" [id="node-confronto", label="Confrontare i campi del testo\nContenuto e ordine coincidono?", shape="diamond", fillcolor="#F0EBF6", tooltip="Il confronto riguarda i campi autorevoli della presentazione."];
"fedele" [id="node-fedele", label="Spiegazione fedele al dossier\nUtilizzabile con gli stessi limiti", shape="box", fillcolor="#E6F3EC", tooltip="Spiegazione fedele al dossier\nUtilizzabile con gli stessi limiti"];
"rifiuto" [id="node-rifiuto", label="Testo non verificato\nIl dossier resta il riferimento", shape="box", fillcolor="#F8EEE8", tooltip="Testo non verificato\nIl dossier resta il riferimento"];
"dossier" -> "ricostruire" [label="fatti autorevoli", style="solid"];
"proposta" -> "piano" [label="piano e testo", style="solid"];
"piano" -> "confronto" [label="piano verificato", style="solid"];
"ricostruire" -> "confronto" [label="testo atteso", style="solid"];
"confronto" -> "fedele" [label="coincidono", style="solid"];
"confronto" -> "rifiuto" [label="differiscono", style="solid"];
}