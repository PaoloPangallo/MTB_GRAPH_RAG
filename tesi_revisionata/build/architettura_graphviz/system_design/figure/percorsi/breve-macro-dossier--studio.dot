graph [label="", labelloc=t, fontname="Arial", fontsize=22, fontcolor="#17343F", labeljust=c];
"step0" [id="macro-node-step0", label="Studio NCT02279004 → BRAF\nRegistro NCT02279004", shape="box", fillcolor="#EAF0F5", tooltip="Studio NCT02279004 → BRAF\nRegistro NCT02279004"];
