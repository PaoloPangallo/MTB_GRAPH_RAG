digraph macro {
graph [rankdir=TB, bgcolor="white", pad="0.22", nodesep="0.30", ranksep="0.40", splines=polyline, outputorder=edgesfirst];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=17, fontcolor="#17343F", color="#AFC4C8", penwidth=1, margin="0.20,0.15"];
edge [color="#617E87", fontname="Arial", fontcolor="#365661", fontsize=13, arrowsize=0.7];
graph [label="Dividere la fonte in passaggi leggibili · Registro di studio clinico", labelloc=t, fontname="Arial", fontsize=22, fontcolor="#17343F", labeljust=c];
"record" [id="node-record", label="Registro NCT02279004", shape="box", fillcolor="#EAF0F5", tooltip="Registro NCT02279004"];
"parti" [id="node-parti", label="Identificare le parti del registro\nTitolo · sintesi · descrizione · condizioni", shape="box", fillcolor="#E8F4F0", tooltip="Identificare le parti del registro\nTitolo · sintesi · descrizione · condizioni"];
"unita" [id="node-unita", label="Parti riconducibili al record consultato", shape="box", fillcolor="#E6F3EC", tooltip="Parti riconducibili al record consultato"];
"record" -> "parti" [label="contenuto strutturato", style="solid"];
"parti" -> "unita" [label="testo e origine", style="solid"];
}