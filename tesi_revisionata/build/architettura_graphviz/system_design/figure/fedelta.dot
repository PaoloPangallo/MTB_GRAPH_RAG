digraph phase {
graph [rankdir="TB", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", splines=polyline, label="Controllare la spiegazione finale", labelloc=t, fontname="Arial", fontsize=21, fontcolor="#17343F"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16, fontcolor="#17343F", color="#B7C9CF", penwidth=1, margin="0.18,0.14"];
edge [color="#718895", fontname="Arial", fontcolor="#365661", fontsize=12, arrowsize=0.65];
"dossier" [id="node-dossier", shape="box", label="Dossier di riferimento", fillcolor="#EAF0F5", tooltip="Dossier di riferimento"];
"proposta" [id="node-proposta", shape="box", label="Spiegazione prodotta dal modello", fillcolor="#EAF0F5", tooltip="Spiegazione prodotta dal modello"];
"struttura" [id="node-struttura", shape="box", label="Struttura, identità e legame con l’ingresso\nOrdine, copertura e impronte", fillcolor="#F0EBF6", tooltip="Struttura, identità e legame con l’ingresso\nOrdine, copertura e impronte"];
"contenuto" [id="node-contenuto", shape="box", label="Vincoli sul testo\nFonti, citazioni e quantità\nStati, polarità, limiti e raccomandazioni", fillcolor="#F0EBF6", tooltip="Vincoli sul testo\nFonti, citazioni e quantità\nStati, polarità, limiti e raccomandazioni"];
"fedele" [id="node-fedele", shape="box", label="Presentazione conforme ai controlli\nCon il limite semantico dichiarato", fillcolor="#E6F3EC", tooltip="Presentazione conforme ai controlli\nCon il limite semantico dichiarato"];
"alternativa" [id="node-alternativa", shape="box", label="Testo deterministico dal dossier", fillcolor="#E8F4F0", tooltip="Testo deterministico dal dossier"];
"esatto" [id="node-esatto", shape="box", label="Verifica separata\nRicostruzione e confronto esatto", fillcolor="#F0EBF6", tooltip="Verifica separata\nRicostruzione e confronto esatto"];
"ripiego" [id="node-ripiego", shape="box", label="Mostrare il ripiego verificato", fillcolor="#E6F3EC", tooltip="Mostrare il ripiego verificato"];
"rifiuto" [id="node-rifiuto", shape="box", label="Solo dossier strutturato", fillcolor="#F8EEE8", tooltip="Solo dossier strutturato"];
"proposta" -> "struttura" [label="testo generato", style="solid"];
"struttura" -> "contenuto" [label="struttura valida", style="solid"];
"dossier" -> "contenuto" [label="riferimento", style="dashed"];
"contenuto" -> "fedele" [label="controlli superati", style="solid"];
"struttura" -> "alternativa" [label="formato non valido", style="solid"];
"contenuto" -> "alternativa" [label="testo respinto", style="solid"];
"dossier" -> "alternativa" [label="fatti del dossier", style="solid"];
"alternativa" -> "esatto" [label="ripiego distinto", style="solid"];
"esatto" -> "ripiego" [label="conforme", style="solid"];
"esatto" -> "rifiuto" [label="non conforme", style="solid"];
}